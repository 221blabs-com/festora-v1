rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin (checking role field on user doc)
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user created the event
    function isEventCreator(eventId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid;
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow create/update but prevent setting role to admin if not already admin
      allow create: if request.auth != null && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin');
      allow update: if request.auth != null && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin' || (resource.data.role == 'admin'));
    }

    // Events
    match /events/{eventId} {
      allow read: if true; // Public events
      allow create: if request.auth != null; // Allow creation
      allow update: if request.auth != null && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Event requests
    match /event_requests/{requestId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null &&
        (resource.data.requesterId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions/Admin SDK can write orders
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions/Admin SDK can write tickets
    }

    // Participants
    match /participants/{participantId} {
        allow read: if request.auth != null && (isAdmin() || isEventCreator(resource.data.eventId));
        allow write: if false;
    }

    // Ticket Analytics
    match /ticket_analytics/{analyticsId} {
      allow read: if request.auth != null &&
        (isAdmin() || isEventCreator(resource.data.eventId));
      allow write: if false;
    }
  }
}
